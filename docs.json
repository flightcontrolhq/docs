{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Ravion Docs",
  "colors": {
    "primary": "#FE6104",
    "light": "#BD4406",
    "dark": "#F6DDCE"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "pages": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "API reference",
            "pages": [
              "api-reference/overview"
            ],
            "openapi": "https://api.ravion.com/openapi.yaml"
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Website",
          "href": "https://www.ravion.com",
          "icon": "globe"
        },
        {
          "anchor": "Dashboard",
          "href": "https://app.ravion.com",
          "icon": "grid-2"
        },
        {
          "anchor": "API reference",
          "href": "/api-reference/overview",
          "icon": "code"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://www.ravion.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open dashboard",
      "href": "https://app.ravion.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "linkedin": "https://www.linkedin.com",
      "x": "https://twitter.com"
    }
  }
}
