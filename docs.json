{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Ravion Docs",
  "colors": {
    "primary": "#FE6104",
    "light": "#BD4406",
    "dark": "#F6DDCE"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "pages": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart"
            ]
          }
        ]
      },
      {
        "tab": "CLI",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "cli/overview",
              "cli/installation",
              "cli/authentication",
              "cli/configuration"
            ]
          },
          {
            "group": "Command reference",
            "pages": [
              "cli/reference/api-key",
              "cli/reference/aws",
              "cli/reference/code-source",
              "cli/reference/default-value",
              "cli/reference/deploy",
              "cli/reference/describe",
              "cli/reference/environment",
              "cli/reference/git",
              "cli/reference/github",
              "cli/reference/gitlab",
              "cli/reference/infrastructure-event",
              "cli/reference/login",
              "cli/reference/logout",
              "cli/reference/logs",
              "cli/reference/membership",
              "cli/reference/metrics",
              "cli/reference/module",
              "cli/reference/organization",
              "cli/reference/pipeline",
              "cli/reference/project",
              "cli/reference/service-account",
              "cli/reference/shell-completion",
              "cli/reference/signup",
              "cli/reference/stack",
              "cli/reference/switch",
              "cli/reference/terraform",
              "cli/reference/user",
              "cli/reference/values",
              "cli/reference/whoami",
              "cli/reference/workspace"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "API reference",
            "pages": [
              "api-reference/overview"
            ],
            "openapi": "https://api.ravion.com/openapi.yaml"
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Website",
          "href": "https://www.ravion.com",
          "icon": "globe"
        },
        {
          "anchor": "Dashboard",
          "href": "https://app.ravion.com",
          "icon": "grid-2"
        },
        {
          "anchor": "CLI",
          "href": "/cli/overview",
          "icon": "terminal"
        },
        {
          "anchor": "API reference",
          "href": "/api-reference/overview",
          "icon": "code"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://www.ravion.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open dashboard",
      "href": "https://app.ravion.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "linkedin": "https://www.linkedin.com",
      "x": "https://twitter.com"
    }
  }
}
